pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        booleanParam(name: 'RUN_BUILD', defaultValue: true, description: 'Gradle shadowJar')
        string(name: 'IMAGE_REPOSITORY', defaultValue: 'docker.io/library/tripplanner', description: 'image name')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'build-NUMBER')
        string(name: 'K8S_NAMESPACE', defaultValue: 'tripplanner', description: 'namespace')
    }

    environment {
        GRADLE_USER_HOME = "${WORKSPACE}/.gradle"
        K8S_DIR = "${WORKSPACE}/infra/kubernetes"
        K8S_RENDER = "${WORKSPACE}/infra/kubernetes/.rendered"
        PATH = "/opt/homebrew/bin:/Users/monadayzek/miniconda3/bin:/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${env.PATH}"
        JAVA_HOME = '/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home'
        DOCKER_HOST = "unix://${env.HOME}/.colima/default/docker.sock"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            when {
                expression { return params.RUN_BUILD }
            }
            steps {
                dir('TripPlannerBot') {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
chmod +x gradlew
./gradlew clean shadowJar --no-daemon
'''
                }
            }
        }

        stage('Docker image') {
            steps {
                script {
                    def tag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : "build-${env.BUILD_NUMBER}"
                    env.DOCKER_IMAGE = "${params.IMAGE_REPOSITORY.trim()}:${tag}"
                    env.IMAGE_PULL_POLICY = 'Never'
                }
                dir('TripPlannerBot') {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
JAR=$(echo build/libs/*.jar)
if [ ! -f "$JAR" ]; then
  echo "RUN_BUILD"
  exit 1
fi
docker build -t "$DOCKER_IMAGE" .
'''
                }
            }
        }

        stage('Load image on VM') {
            steps {
                withCredentials([
                    string(credentialsId: 'k8s-node-host', variable: 'K8S_NODE_HOST'),
                    sshUserPrivateKey(credentialsId: 'ya-cloud-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')
                ]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
SSH_OPTS=(
  -i "$SSH_KEY"
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ServerAliveInterval=30
  -o ServerAliveCountMax=120
)
docker save "$DOCKER_IMAGE" | ssh "${SSH_OPTS[@]}" "${SSH_USER}@${K8S_NODE_HOST}" "sudo k3s ctr images import -"
'''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG'),
                    string(credentialsId: 'telegram-bot-token', variable: 'TG_TOKEN'),
                    string(credentialsId: 'mongo-uri-k8s', variable: 'MONGO_URI')
                ]) {
                    sh """#!/usr/bin/env bash
set -euo pipefail
export KUBECONFIG="\${KUBECONFIG}"
NS="${params.K8S_NAMESPACE}"

kubectl create secret generic tripplanner-secrets \\
  --namespace "\$NS" \\
  --from-literal=TELEGRAM_BOT_TOKEN="\$TG_TOKEN" \\
  --from-literal=SPRING_DATA_MONGODB_URI="\$MONGO_URI" \\
  --from-literal=SPRING_DATA_MONGODB_DATABASE=tripplanner \\
  --dry-run=client -o yaml | kubectl apply -f -

kubectl apply -n "\$NS" -f "\$K8S_DIR/tripplanner-service.yaml"

mkdir -p "\$K8S_RENDER"
sed -e "s|__APP_IMAGE__|${env.DOCKER_IMAGE}|g" \\
    -e "s|__IMAGE_PULL_POLICY__|${env.IMAGE_PULL_POLICY}|g" \\
    "\$K8S_DIR/tripplanner-deployment.yaml" > "\$K8S_RENDER/tripplanner-deployment.rendered.yaml"
kubectl apply -n "\$NS" -f "\$K8S_RENDER/tripplanner-deployment.rendered.yaml"

kubectl rollout status deployment/tripplanner -n "\$NS" --timeout=600s
"""
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'TripPlannerBot/build/libs/*.jar, infra/kubernetes/.rendered/*.yaml', allowEmptyArchive: true, fingerprint: true
        }
    }
}
