pipeline {
    agent any

    environment {
        TELEGRAM_TOKEN = credentials('telegram-bot-token')
        MONGO_URI = credentials('mongo-uri-k8s')

        DOCKER_IMAGE = 'docker.io/flugmaschine/tripplanner'
        IMAGE_TAG = "${env.BUILD_NUMBER ?: 'latest'}"

        K8S_NAMESPACE = 'tripplanner'

        PATH = "/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
        DOCKER_HOST = "unix://${env.HOME}/.colima/default/docker.sock"
    }

    stages {
        stage('Build') {
            steps {
                checkout scm

                dir('TripPlannerBot') {
                    sh 'chmod +x gradlew && ./gradlew clean shadowJar --no-daemon'
                    sh '''
                        export DOCKER_BUILDKIT=1
                        docker buildx build --platform linux/amd64 --load \
                          -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                          -t ${DOCKER_IMAGE}:latest \
                          .
                    '''
                }
            }
        }

        stage('Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Start k3s on VM') {
            steps {
                withCredentials([
                    string(credentialsId: 'k8s-node-host', variable: 'K8S_NODE_HOST'),
                    sshUserPrivateKey(credentialsId: 'ya-cloud-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')
                ]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
chmod 600 "$SSH_KEY" || true
SSH_OPTS=(
  -i "$SSH_KEY"
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ServerAliveInterval=30
)
ssh "${SSH_OPTS[@]}" "${SSH_USER}@${K8S_NODE_HOST}" \
  'sudo systemctl start k3s; for i in $(seq 1 60); do sudo k3s kubectl get nodes --request-timeout=5s >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
'''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    if ! command -v kubectl &> /dev/null; then
                        ARCH=$(uname -m | sed 's/x86_64/amd64/' | sed 's/aarch64/arm64/')
                        curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${ARCH}/kubectl"
                        chmod +x kubectl && mv kubectl /usr/local/bin/
                    fi
                '''

                sh 'rm -rf k8s && cp -r infra/kubernetes k8s'

                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh 'kubectl apply -f k8s/namespace.yaml'
                    sh "kubectl apply -f k8s/mongo.yaml -n ${env.K8S_NAMESPACE}"

                    sh """
                        kubectl create secret generic tripplanner-secrets \\
                            --namespace=${env.K8S_NAMESPACE} \\
                            --from-literal=TELEGRAM_BOT_TOKEN=\${TELEGRAM_TOKEN} \\
                            --from-literal=SPRING_DATA_MONGODB_URI=\${MONGO_URI} \\
                            --from-literal=SPRING_DATA_MONGODB_DATABASE=tripplanner \\
                            --dry-run=client -o yaml | kubectl apply -f -
                    """

                    sh "kubectl apply -f k8s/tripplanner-service.yaml -n ${env.K8S_NAMESPACE}"
                    sh """
                        sed -e 's|__APP_IMAGE__|${env.DOCKER_IMAGE}:${env.IMAGE_TAG}|g' \\
                            -e 's|__IMAGE_PULL_POLICY__|Always|g' \\
                            k8s/tripplanner-deployment.yaml > k8s/tripplanner-deployment.rendered.yaml
                        kubectl apply -f k8s/tripplanner-deployment.rendered.yaml -n ${env.K8S_NAMESPACE}
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                        kubectl rollout status deployment/mongo -n ${env.K8S_NAMESPACE} --timeout=600s
                        kubectl rollout status deployment/tripplanner -n ${env.K8S_NAMESPACE} --timeout=300s
                        kubectl get pods -n ${env.K8S_NAMESPACE} -o wide
                        kubectl get svc -n ${env.K8S_NAMESPACE}
                    """
                }
            }
        }
    }
}
