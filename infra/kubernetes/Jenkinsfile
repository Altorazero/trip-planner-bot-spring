pipeline {
    agent { label 'windows' } // либо 'any', если только один агент и он Windows

    environment {
        TELEGRAM_TOKEN = credentials('telegram-bot-token')
        MONGO_URI = credentials('mongo-uri-k8s')
        DOCKER_IMAGE = 'docker.io/altorazero/tripplanner'
        IMAGE_TAG = "${env.BUILD_NUMBER ?: 'latest'}"
        K8S_NAMESPACE = 'tripplanner'
        // PATH -- не нужно переопределять на Windows
        // DOCKER_HOST -- скорее всего не нужно, если работает Docker Desktop
    }

stage('Build') {
    steps {
        checkout scm

        dir('TripPlannerBot') {
            powershell '.\\gradlew.bat clean shadowJar --no-daemon'

            powershell '''
                $env:DOCKER_BUILDKIT=1

                Write-Host "DOCKER_IMAGE = '$env:DOCKER_IMAGE'"
                Write-Host "IMAGE_TAG   = '$env:IMAGE_TAG'"
                Write-Host "FULL IMAGE  = '$env:DOCKER_IMAGE`:$env:IMAGE_TAG'"

                Write-Host "=== Building image $env:DOCKER_IMAGE`:$env:IMAGE_TAG ==="

                docker buildx build --platform linux/amd64 --load -t "$env:DOCKER_IMAGE`:$env:IMAGE_TAG" .
            '''
        }
    }
}

        stage('Push') {
            steps {
                powershell '''
                    Write-Host "Pushing ${env:DOCKER_IMAGE}:${env:IMAGE_TAG}"
                    
                    docker push $env:DOCKER_IMAGE`:$env:IMAGE_TAG
                '''    
            }
        }

        stage('Start k3s on VM') {
            steps {
                withCredentials([
                    string(credentialsId: 'k8s-node-host', variable: 'K8S_NODE_HOST'),
                    sshUserPrivateKey(credentialsId: 'ya-cloud-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')
                ]) {
                    powershell '''
                        $sshKey = $env:SSH_KEY
                        # !!! icacls fix остается
                        icacls "$sshKey" /inheritance:r
                        icacls "$sshKey" /grant:r "$($env:USERNAME):(R)"
                        icacls "$sshKey" /remove "Users" "Authenticated Users" "BUILTIN\\Administrators" "Everyone"
                        $k8sHost = $env:K8S_NODE_HOST
                        $sshUser = $env:SSH_USER
                        # ОТПРАВИМ ИМЕННО bash-цикл на сервер, НЕ PowerShell:
                        ssh -i "$sshKey" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 `
                          "$sshUser@$k8sHost" `
                          "sudo systemctl start k3s; for i in {1..60}; do sudo k3s kubectl get nodes --request-timeout=5s >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                powershell 'Remove-Item -Recurse -Force k8s; Copy-Item -Recurse infra/kubernetes k8s'

                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    powershell '''
                        $env:KUBECONFIG = "$env:KUBECONFIG"
                        
                        kubectl apply -f k8s/namespace.yaml --validate=false
                        kubectl apply -f k8s/mongo.yaml -n $env:K8S_NAMESPACE
                        
                        # Secrets
                        kubectl create secret generic tripplanner-secrets `
                            --namespace=$env:K8S_NAMESPACE `
                            --from-literal=TELEGRAM_BOT_TOKEN=$env:TELEGRAM_TOKEN `
                            --from-literal=SPRING_DATA_MONGODB_URI=$env:MONGO_URI `
                            --from-literal=SPRING_DATA_MONGODB_DATABASE=tripplanner `
                            --dry-run=client -o yaml | kubectl apply -f -
                        
                        kubectl apply -f k8s/tripplanner-service.yaml -n $env:K8S_NAMESPACE
                        
                        # Render deployment с правильным тегом
                        $deployYaml = Get-Content k8s/tripplanner-deployment.yaml -Raw
                        Write-Host "DOCKER_IMAGE = '$env:DOCKER_IMAGE'"
                        Write-Host "IMAGE_TAG   = '$env:IMAGE_TAG'"
                        Write-Host "FULL IMAGE  = '$env:DOCKER_IMAGE`:$env:IMAGE_TAG'"
                        $deployYaml = $deployYaml -replace '__APP_IMAGE__', "$env:DOCKER_IMAGE`:$env:IMAGE_TAG"
                        $deployYaml = $deployYaml -replace '__IMAGE_PULL_POLICY__', 'IfNotPresent'
                        $deployYaml | Set-Content k8s/tripplanner-deployment.rendered.yaml
                        
                        kubectl apply -f k8s/tripplanner-deployment.rendered.yaml -n $env:K8S_NAMESPACE
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    powershell '''
                        $env:KUBECONFIG = "$env:KUBECONFIG"
                        kubectl rollout status deployment/mongo -n $env:K8S_NAMESPACE --timeout=300s
                        kubectl rollout status deployment/tripplanner -n $env:K8S_NAMESPACE --timeout=180s
                        kubectl get pods -n $env:K8S_NAMESPACE -o wide
                        kubectl get svc -n $env:K8S_NAMESPACE
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'TripPlannerBot\\build\\libs\\*.jar', fingerprint: true, allowEmptyArchive: true
        }
    }
}
